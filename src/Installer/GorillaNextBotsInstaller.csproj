<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the exe runs anywhere with
         nothing to install first. That is the whole point of an installer. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GorillaNextBotsInstaller</AssemblyName>
    <RootNamespace>GorillaNextBots.Installer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <!-- No .pdb next to the exe, and no local paths baked into it -->
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyTitle>GorillaNextBots Installer</AssemblyTitle>
    <Product>GorillaNextBots</Product>
    <Company>stridefr</Company>
    <Copyright>stridefr</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
